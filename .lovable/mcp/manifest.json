{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://npwofemokwddtutugmas.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nazra-erp-mcp",
      "version": "0.1.0",
      "title": "Nazra ERP"
    },
    "tools": [
      {
        "name": "list_customers",
        "title": "List customers",
        "description": "List customers visible to the signed-in user (scoped by tenant RLS). Optionally filter by name/phone/email.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Optional fuzzy search across name, phone, and email."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return (1-100)."
            },
            "only_active": {
              "type": "boolean",
              "default": true,
              "description": "Return only active customers when true."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the product catalog visible to the signed-in user by name or SKU.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Fuzzy search across product name and SKU."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Max products to return (1-50)."
            }
          },
          "required": [
            "search"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_invoices",
        "title": "List recent invoices",
        "description": "List the most recent invoices visible to the signed-in user (scoped by tenant RLS).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Max invoices to return (1-100)."
            },
            "status": {
              "type": "string",
              "description": "Optional invoice status filter (e.g. draft, posted, paid, cancelled)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
